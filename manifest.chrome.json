{
	"manifest_version": 3,
	"name": "Tab Groups Rock",
	"version": "0.1.0",
	"description": "Save a Chrome tab group as a Markdown note in Obsidian, with a link to every tab.",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"options_page": "options.html",
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": [
		"tabs",
		"tabGroups",
		"storage",
		"clipboardWrite",
		"contextMenus"
	],
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+G",
				"mac": "Command+Shift+G"
			},
			"description": "Open Tab Groups Rock"
		}
	}
}
